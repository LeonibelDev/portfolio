---
import GitHubIcon from "./icons/GitHub.astro"
import LinkedInIcon from "./icons/LinkedIn.astro"
import MailIcon from "./icons/Mail.astro"
---

<footer class="mt-8 border-t border-[#24313a]/10 bg-[#24313a] text-white shadow-[0_-12px_30px_rgba(23,33,43,0.06)]">
  <div class="mx-auto flex max-w-5xl flex-col gap-6 px-4 py-7 md:flex-row md:items-center md:justify-between md:px-8">
    <div>
      <p class="font-semibold text-white">Leonibel Segura</p>
      <p class="mt-1 text-xs text-white/45">Full-stack developer · Santo Domingo, Dominican Republic</p>
      <p class="mt-2 text-xs text-white/30">© {new Date().getFullYear()} Leonibel Segura</p>
    </div>

    <div class="flex flex-wrap items-center gap-x-5 gap-y-3 text-xs text-white/55">
      <a href="https://github.com/leonibeldev" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 transition hover:text-white">
        <GitHubIcon class="size-4" />
        GitHub
      </a>
      <a href="https://www.linkedin.com/in/leonibel-segura-ramirez-14a7392a9/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 transition hover:text-white">
        <LinkedInIcon class="size-4" />
        LinkedIn
      </a>
      <a href="mailto:leonibel.ramirez@gmail.com" class="inline-flex items-center gap-2 border border-[#2f6fed] px-3 py-2 font-semibold text-[#6f9cf5] transition hover:bg-[#2f6fed] hover:text-white">
        <MailIcon class="size-4" />
        Email
      </a>
    </div>
  </div>
</footer>
