---
const PROJECTS = [
  {
    title: "MyTechBlog.dev",
    description:
      "High-performance technical blogging platform built with Go and PostgreSQL, focused on backend scalability, efficient data retrieval, and modern content publishing workflows.",
    github: "https://github.com/LeonibelDev/askme",
    tags: ["Go", "PostgreSQL", "Backend", "API"],
    type: "Editorial platform",
    signal: "GET /posts 200 OK",
  },
  {
    title: "Cuurt.cc",
    description:
      "Scalable URL shortener with encrypted redirects and custom Base62 encoding, designed to optimize lookup performance and keep the service efficient under traffic demand.",
    github: "https://github.com/LeonibelDev/url-shortener",
    tags: ["Go", "Security", "Algorithms", "System Design"],
    type: "Infrastructure tool",
    signal: "short / e607ba72",
  },
  {
    title: "pgg-cli",
    description:
      "Terminal-first CLI tool created to automate repetitive development tasks, including command parsing, flags, and file system operations to improve developer productivity.",
    github: "https://github.com/LeonibelDev/pgg-cli",
    tags: ["Go", "CLI", "Automation", "Developer Tools"],
    type: "Developer utility",
    signal: "$ pgg run --fast",
  },
  {
    title: "SaveMyPass.dev",
    description:
      "Secure password management application centered on zero-knowledge principles, protected storage, and user-friendly credential handling.",
    github: "https://github.com/LeonibelDev/SaveMyPass.dev",
    tags: ["Security", "Product", "Backend", "Privacy"],
    type: "Security product",
    signal: "vault / encrypted",
  },
  {
    title: "Secure Studio",
    description:
      "Spring Boot backend API for sensor management and real-time monitoring, designed for operational visibility and service scalability.",
    github: "https://github.com/LeonibelDev/secure-studio",
    tags: ["Java", "Spring Boot", "REST", "Monitoring"],
    type: "Monitoring system",
    signal: "sensor_04 / online",
  },
]
---

<div class="grid gap-5 md:grid-cols-2">
  {
    PROJECTS.map(({ title, description, github, tags, type, signal }, index) => (
      <article class:list={[
        "group flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-[#d8dee2] bg-white shadow-[0_12px_30px_rgba(23,33,43,0.05)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_18px_38px_rgba(23,33,43,0.1)]",
        index === 0 && "md:col-span-2",
      ]}>
        <div class="relative flex min-h-36 items-end justify-between overflow-hidden border-b border-[#24313a] bg-[#24313a] p-5 text-white md:min-h-44 md:p-7">
          <div class="absolute inset-0 opacity-20 [background-image:linear-gradient(#ffffff_1px,transparent_1px),linear-gradient(90deg,#ffffff_1px,transparent_1px)] [background-size:28px_28px]"></div>
          <svg class="absolute right-5 top-5 size-7 text-[#8daef0] md:right-7 md:top-7" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m8 9-3 3 3 3" />
            <path d="m16 9 3 3-3 3" />
            <path d="m14 5-4 14" />
          </svg>
          <span class="relative text-6xl font-black tracking-[-0.1em] text-white/90 md:text-8xl">0{index + 1}</span>
          <span class="relative max-w-[12rem] text-right font-mono text-xs leading-5 text-[#8daef0] md:text-sm">{signal}</span>
        </div>

        <div class:list={[
          "flex flex-col p-5 md:p-7",
          index === 0 && "md:justify-center",
          "min-h-64",
        ]}>
          <span class="mb-8 text-[10px] font-semibold uppercase tracking-[0.12em] text-[#65717a]">{type}</span>

          <div class="mb-5 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="rounded-full bg-[#e9edf0] px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.06em] text-[#65717a]">
                {tag}
              </span>
            ))}
          </div>

          <h3 class="mb-3 text-2xl font-semibold tracking-[-0.04em] text-[#17212b] md:text-3xl">{title}</h3>
          <p class="mb-7 max-w-xl text-sm leading-6 text-[#65717a] md:text-base">{description}</p>

          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-auto inline-flex w-fit items-center gap-2 text-sm font-semibold text-[#2f6fed] transition group-hover:gap-3"
          >
            Explore project
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17 17 7" />
              <path d="M7 7h10v10" />
            </svg>
          </a>
        </div>
      </article>
    ))
  }
</div>
