---
interface Props {
  title: string
  description: string
  link?: string
  date: string
  index: number
}

const { title, description, link, date, index } = Astro.props
---

<article class="relative grid gap-5 px-4 py-6 transition-colors duration-200 group-hover:bg-white/70 md:grid-cols-[7rem_1fr] md:gap-8 md:px-6 md:py-8">
  <div class="flex items-start justify-between gap-4 md:block">
    <span class="font-mono text-xs font-medium text-[#65717a]">0{index}</span>
    <time class="text-right text-xs font-medium uppercase tracking-[0.08em] text-[#65717a] md:mt-5 md:block md:text-left">
      {date}
    </time>
  </div>

  <div class="relative border-l-2 border-[#d8dee2] pl-5 transition-colors duration-200 group-hover:border-[#2f6fed] md:pl-7">
    <div class="mb-3 flex items-start gap-3">
      <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full border border-[#d8dee2] text-[#65717a] transition-colors group-hover:border-[#2f6fed] group-hover:text-[#2f6fed]">
        <svg class="size-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="7" width="18" height="13" rx="2" />
          <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
          <path d="M3 12h18" />
        </svg>
      </span>
      <h3 class="text-xl font-semibold tracking-[-0.03em] text-[#17212b] md:text-2xl">{title}</h3>
    </div>
    <p class="mt-3 max-w-2xl text-base leading-7 text-[#65717a]">{description}</p>
    {
      link && (
        <a
          href={link}
          class="mt-5 inline-flex items-center gap-x-2 text-sm font-semibold text-[#2f6fed] transition hover:gap-x-3"
        >
          Learn more
            <svg
            class="size-4"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 14 10"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M1 5h12m0 0L9 1m4 4L9 9"
            />
          </svg>
        </a>
      )
    }
  </div>
</article>
