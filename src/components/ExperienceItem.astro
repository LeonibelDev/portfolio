---
interface Props {
  title: string
  description: string
  link?: string
  date: string
}

const { title, description, link, date } = Astro.props
---

<div class="absolute mt-1.5 h-3 w-3 -start-1.5 rounded-full border border-[#c4c4c8] bg-[#1d1d1f]"></div>
<time class="mb-1 block text-sm font-medium leading-none text-[#6b7280]">{date}</time>
<h3 class="mt-3 text-xl font-semibold text-[#1d1d1f]">{title}</h3>
<p class="mb-4 mt-2 max-w-2xl text-base leading-7 text-[#57575d]">{description}</p>
{
  link && (
    <a
      href={link}
      class="inline-flex items-center gap-x-2 rounded-full border border-[#e5e5e7] bg-white px-3 py-2 text-sm text-[#1d1d1f] transition hover:bg-[#f7f7f8]"
    >
      Learn more
      <svg
        class="h-3 w-3"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 14 10"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M1 5h12m0 0L9 1m4 4L9 9"
        />
      </svg>
    </a>
  )
}
